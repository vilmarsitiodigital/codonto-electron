# URL do backend (API)
API_URL=https://webhook.artdental.com.br

# Token opcional do agente (gerado no servidor — setup-node.sh).
# Se preenchido, tem prioridade e bloqueia a edição na tela inicial.
# Se vazio, o usuário informa o token na tela e ele é salvo criptografado.
AGENT_TOKEN=

# URL do Codonto (sistema odontológico)
CODONTO_URL=https://co.aplicativo.net/

# Intervalo de polling em segundos (padrão na UI: 15)
# POLL_INTERVAL=60

# Atraso artificial entre ações do Playwright em ms (0 = desligado, útil para debug)
# PLAYWRIGHT_SLOW_MO=200

# Data fixa para buscar tarefas (YYYY-MM-DD). Se omitido, usa config da UI.
# TAREFAS_DESDE=2026-06-28
